+// Visual fork: an original cyan V icon, independent of upstream branding.
+fn visual_window_icon() -> Option<winit::window::Icon> {
+    if !cfg!(feature = "visual-client") { return horizon_client::window::icon(); }
+    let mut pixels = vec![0u8; 32 * 32 * 4];
+    for y in 0..32usize {
+        for x in 0..32usize {
+            let arm = 6.0 + (y as f32 - 6.0) * 0.45;
+            let mark = (6..26).contains(&y) && ((x as f32 - arm).abs() < 2.0 || (x as f32 - (31.0 - arm)).abs() < 2.0);
+            let color = if mark { [75, 220, 240, 255] } else { [12, 20, 36, 255] };
+            pixels[(y * 32 + x) * 4..(y * 32 + x + 1) * 4].copy_from_slice(&color);
+        }
+    }
+    winit::window::Icon::from_rgba(pixels, 32, 32).ok()
+}
