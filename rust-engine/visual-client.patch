index d2f0b4e..b4f4181 100644
--- a/crates/horizon-client/src/extras.rs
+++ b/crates/horizon-client/src/extras.rs
@@ -287,6 +287,23 @@ impl Extras {
 pub fn fov_target(vanilla: f32, zoom: f32) -> f32 {
     if zoom == 1.0 { vanilla } else { vanilla / zoom }
 }
+
+/// Multiplicative wheel zoom, bounded even for high-resolution trackpads.
+pub fn visual_scroll_zoom(factor: f32, delta: f32) -> f32 {
+    if !delta.is_finite() { return factor; }
+    (factor * 1.2_f32.powf(delta.clamp(-20.0, 20.0))).clamp(1.0, 32.0)
+}
+
+#[test]
+fn visual_zoom_wheel_bounds_and_reversal() {
+    let near = visual_scroll_zoom(4.0, 1.0);
+    assert!(near > 4.0);
+    assert!((visual_scroll_zoom(near, -1.0) - 4.0).abs() < 0.00001);
+    assert_eq!(visual_scroll_zoom(32.0, 20.0), 32.0);
+    assert_eq!(visual_scroll_zoom(1.0, -20.0), 1.0);
+    assert_eq!(visual_scroll_zoom(4.0, f32::NAN), 4.0);
+    assert_eq!(visual_scroll_zoom(4.0, f32::INFINITY), 4.0);
+}
